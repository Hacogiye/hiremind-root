# HireMind — AI provider config (OpenAI-compatible)
# Copy this file to .env and fill in your real values. NEVER commit .env.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=main_model
# Optional: model cho tác vụ vision (OCR ảnh CV, chat kèm ảnh) khi model text không "nhìn" được ảnh.
# Để trống = dùng chung AI_MODEL.
AI_VISION_MODEL=
PORT=3000
